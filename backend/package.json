{
  "name": "2annews-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate:mysql-to-postgres": "node scripts/migrate-mysql-to-postgres.mjs",
    "prisma:seed": "prisma db seed",
    "news:import": "tsx scripts/import-recent-news.ts",
    "transfers:import-news": "tsx scripts/import-transfer-news.ts",
    "transfers:import-recent": "tsx scripts/import-recent-transfers.ts",
    "clubs:import": "tsx scripts/import-world-clubs.ts",
    "news:sync-photos": "tsx scripts/sync-editorial-photos.ts",
    "notifications:backfill": "tsx scripts/backfill-engagement-notifications.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "2annews": "file:..",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
